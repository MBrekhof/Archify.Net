*.cs               text eol=crlf
*.csproj           text eol=crlf
*.md               text
# Byte-exact oracles and upstream data: never normalise line endings. Must stay after the generic rules above.
upstream/**        -text
tests/goldens/**   -text
tests/fixtures/**  -text
# The skill package is compared byte for byte with upstream's LF files (SkillPackageTests); autocrlf must not touch it.
skill/**           -text

# Showcase pages are served as committed (GitHub Pages) and compared by ExplainerParityTests.
showcase/** -text
