{
  "document": {
    "schema_version": 1,
    "diagram_type": "explainer",
    "meta": {
      "title": "What happens when a browser opens an HTTPS site for the first time?",
      "id": "first-visit",
      "locale": "en"
    },
    "answer": {
      "summary": "The browser resolves the hostname, opens TCP, then runs a **one-round-trip TLS 1.3 handshake**. It agrees fresh encryption keys and checks the server's identity before any request is sent.",
      "reasons": [
        "The browser sends its key share inside `ClientHello`, so one round trip is enough.[](source:rfc8446)",
        "After `ServerHello` everything is encrypted, including the server's certificate.[](source:rfc8446)",
        "`CertificateVerify` proves the server holds the certificate's private key.",
        "Keys come from ephemeral shares, so a later leak of the private key cannot decrypt this session."
      ],
      "scope": "TLS 1.3 over TCP · first visit to a host · no proxy, no resumption"
    },
    "panels": [
      {
        "id": "wire",
        "title": "What crosses the wire before the first request?",
        "blocks": [
          {
            "type": "diagram",
            "id": "tls-visit",
            "diagramType": "sequence",
            "spec": {
              "schema_version": 1,
              "diagram_type": "sequence",
              "meta": {
                "title": "First HTTPS visit: DNS to first response",
                "output": "tls-visit.html",
                "quality_profile": "showcase"
              },
              "participants": [
                {
                  "id": "browser",
                  "label": "Browser",
                  "type": "frontend"
                },
                {
                  "id": "dns",
                  "label": "DNS resolver",
                  "type": "external"
                },
                {
                  "id": "server",
                  "label": "Web server",
                  "type": "backend"
                }
              ],
              "messages": [
                {
                  "id": "browser-to-dns-1",
                  "from": "browser",
                  "to": "dns",
                  "label": "DNS query: example.com",
                  "y": 160
                },
                {
                  "id": "dns-to-browser-1",
                  "from": "dns",
                  "to": "browser",
                  "label": "IP address",
                  "y": 208,
                  "variant": "return"
                },
                {
                  "id": "browser-to-server-1",
                  "from": "browser",
                  "to": "server",
                  "label": "SYN",
                  "y": 256
                },
                {
                  "id": "server-to-browser-1",
                  "from": "server",
                  "to": "browser",
                  "label": "SYN + ACK",
                  "y": 304,
                  "variant": "return"
                },
                {
                  "id": "browser-to-server-2",
                  "from": "browser",
                  "to": "server",
                  "label": "ACK",
                  "y": 352
                },
                {
                  "id": "browser-to-server-3",
                  "from": "browser",
                  "to": "server",
                  "label": "ClientHello: suites, SNI, key share",
                  "y": 400
                },
                {
                  "id": "server-to-browser-2",
                  "from": "server",
                  "to": "browser",
                  "label": "ServerHello: chosen suite, key share",
                  "y": 448,
                  "variant": "return"
                },
                {
                  "id": "server-to-browser-3",
                  "from": "server",
                  "to": "browser",
                  "label": "Certificate + CertificateVerify + Finished, encrypted",
                  "y": 496,
                  "variant": "return"
                },
                {
                  "id": "browser-to-server-4",
                  "from": "browser",
                  "to": "server",
                  "label": "Finished",
                  "y": 544,
                  "variant": "emphasis"
                },
                {
                  "id": "browser-to-server-5",
                  "from": "browser",
                  "to": "server",
                  "label": "GET /",
                  "y": 592
                },
                {
                  "id": "server-to-browser-4",
                  "from": "server",
                  "to": "browser",
                  "label": "200 OK + page",
                  "y": 640,
                  "variant": "return"
                }
              ],
              "segments": [
                {
                  "from": 138,
                  "to": 224,
                  "label": "Name lookup"
                },
                {
                  "from": 234,
                  "to": 368,
                  "label": "TCP handshake · 1 RTT"
                },
                {
                  "from": 378,
                  "to": 560,
                  "label": "TLS 1.3 handshake · 1 RTT"
                },
                {
                  "from": 570,
                  "to": 656,
                  "label": "Encrypted HTTP"
                }
              ]
            }
          },
          {
            "type": "steps",
            "id": "visit-steps",
            "items": [
              {
                "id": "resolve",
                "text": "DNS resolver",
                "detail": "Turns the hostname into an IP before the connection can start.",
                "target": {
                  "diagram": "tls-visit",
                  "node": "dns"
                }
              },
              {
                "id": "hello",
                "text": "Browser",
                "detail": "Opens TCP and sends `ClientHello` with TLS 1.3, cipher suites, the hostname and an ephemeral key share.",
                "target": {
                  "diagram": "tls-visit",
                  "node": "browser"
                }
              },
              {
                "id": "prove",
                "text": "Web server",
                "detail": "Sends its key share, then certificate and `Finished` under encryption; checks the client's `Finished`.",
                "target": {
                  "diagram": "tls-visit",
                  "node": "server"
                }
              }
            ]
          },
          {
            "type": "callout",
            "id": "quic",
            "level": "note",
            "title": "What about HTTP/3?",
            "text": "With QUIC, the TCP steps disappear: QUIC runs the same TLS 1.3 handshake inside the transport, still in one round trip."
          }
        ]
      },
      {
        "id": "trust",
        "title": "How does the browser know this is the real site?",
        "blocks": [
          {
            "type": "comparison",
            "labelColumn": "Check",
            "columns": [
              "What the browser verifies"
            ],
            "rows": [
              {
                "label": "Chain",
                "cells": [
                  {
                    "text": "The certificate chains to a root CA in the browser's trust store."
                  }
                ],
                "id": "row-4be7b77bb1db"
              },
              {
                "label": "Hostname",
                "cells": [
                  {
                    "text": "The site's name appears in the certificate's subject alternative name (SAN) list."
                  }
                ],
                "id": "row-80ffe0de4f96"
              },
              {
                "label": "Validity",
                "cells": [
                  {
                    "text": "Today sits inside the certificate's not-before and not-after dates."
                  }
                ],
                "id": "row-36c6c4c1ae7d"
              },
              {
                "label": "Ownership",
                "cells": [
                  {
                    "text": "`CertificateVerify` signs the handshake transcript; only the private-key holder could produce it."
                  }
                ],
                "id": "row-7bade94aea6d"
              },
              {
                "label": "Revocation",
                "cells": [
                  {
                    "text": "Stapled OCSP or CRLs, checked best-effort; many browsers accept an unreachable check.",
                    "assessment": "caution",
                    "verdict": "Weak"
                  }
                ],
                "id": "row-11f1c3120475"
              }
            ],
            "id": "comparison-bb5a9b839cc3"
          }
        ]
      },
      {
        "id": "keys",
        "title": "Where do the session keys come from?",
        "blocks": [
          {
            "type": "facts",
            "id": "key-facts",
            "entries": [
              {
                "key": "Key shares",
                "value": "Each side sends an ephemeral Diffie-Hellman share, usually X25519."
              },
              {
                "key": "Shared secret",
                "value": "Each side combines its private share with the peer's public share."
              },
              {
                "key": "Key schedule",
                "value": "HKDF expands the secret plus the transcript into handshake, then traffic keys."
              },
              {
                "key": "Forward secrecy",
                "value": "Shares are discarded after use, so later key theft cannot decrypt this session."
              },
              {
                "key": "Client `Finished`",
                "value": "Confirms both sides hold the same keys; the request can now ride on them."
              }
            ]
          }
        ]
      },
      {
        "id": "revisit",
        "title": "What changes on the next visit?",
        "blocks": [
          {
            "type": "comparison",
            "labelColumn": "Aspect",
            "columns": [
              "First visit",
              "Resumed visit"
            ],
            "rows": [
              {
                "label": "Server proof",
                "cells": [
                  {
                    "text": "Full certificate and signature check"
                  },
                  {
                    "text": "Pre-shared key from a `NewSessionTicket`"
                  }
                ],
                "id": "row-f516c079dd45"
              },
              {
                "label": "Round trips to first byte",
                "cells": [
                  {
                    "text": "DNS + TCP + 1 RTT of TLS"
                  },
                  {
                    "text": "TCP, then data can ride with `ClientHello`",
                    "assessment": "good",
                    "verdict": "0-RTT"
                  }
                ],
                "id": "row-37195b147126"
              },
              {
                "label": "Early data risk",
                "cells": [
                  {
                    "text": "None; the request waits for `Finished`"
                  },
                  {
                    "text": "0-RTT data can be replayed, so servers limit what it may do",
                    "assessment": "caution",
                    "verdict": "Replayable"
                  }
                ],
                "id": "row-6293b8d366bb"
              }
            ],
            "id": "comparison-c43d01ae0a4f"
          }
        ]
      }
    ],
    "sources": [
      {
        "id": "rfc8446",
        "title": "RFC 8446: The Transport Layer Security (TLS) Protocol Version 1.3",
        "url": "https://www.rfc-editor.org/rfc/rfc8446"
      }
    ]
  },
