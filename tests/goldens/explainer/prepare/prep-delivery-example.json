  "sourceText": "{\n  \"schema_version\": 1,\n  \"diagram_type\": \"explainer\",\n  \"meta\": {\n    \"title\": \"缓存未命中时，请求为什么变慢？\",\n    \"id\": \"mechanism\",\n    \"locale\": \"zh-CN\"\n  },\n  \"answer\": {\n    \"summary\": \"缓存未命中后，请求要多等**数据库查询和同步写回缓存**两段。\",\n    \"reasons\": [\n      \"命中时，接口读到缓存值就能返回。\",\n      \"未命中时，接口必须先拿到数据库结果。\",\n      \"同步写回位于响应之前，写完缓存才能结束请求。\"\n    ],\n    \"scope\": \"示例采用旁路缓存：GET返回空值后查询PostgreSQL，查询成功后同步SET再响应；无并行、重试或其他缓存层。未实测耗时，具体慢多少由链路测量决定。\"\n  },\n  \"panels\": [\n    {\n      \"id\": \"timeline\",\n      \"title\": \"一次未命中，时间花在哪？\",\n      \"blocks\": [\n        {\n          \"type\": \"steps\",\n          \"id\": \"cache-path-steps\",\n          \"items\": [\n            {\n              \"id\": \"get-step\",\n              \"text\": \"读取缓存\",\n              \"detail\": \"GET返回空值，接口继续向数据库查询。[](source:get-doc)\"\n            },\n            {\n              \"id\": \"query-step\",\n              \"text\": \"查询PostgreSQL\",\n              \"detail\": \"等待数据库执行SQL并返回结果。\"\n            },\n            {\n              \"id\": \"set-step\",\n              \"text\": \"同步写回Redis\",\n              \"detail\": \"SET完成后，接口返回响应。[](source:set-doc)\"\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"id\": \"diff\",\n      \"title\": \"命中和未命中，差在哪几步？\",\n      \"blocks\": [\n        {\n          \"type\": \"comparison\",\n          \"id\": \"cache-comparison\",\n          \"columns\": [\n            \"命中\",\n            \"未命中\"\n          ],\n          \"rows\": [\n            {\n              \"label\": \"读Redis\",\n              \"cells\": [\n                {\n                  \"text\": \"取得值\",\n                  \"assessment\": \"good\",\n                  \"verdict\": \"直接返回\"\n                },\n                {\n                  \"text\": \"取得空值\",\n                  \"assessment\": \"caution\",\n                  \"verdict\": \"继续查询\"\n                }\n              ],\n              \"id\": \"row-67fe9814e476\"\n            },\n            {\n              \"label\": \"查PostgreSQL\",\n              \"cells\": [\n                {\n                  \"text\": \"跳过\",\n                  \"assessment\": \"good\",\n                  \"verdict\": \"省去查询\"\n                },\n                {\n                  \"text\": \"等待结果\",\n                  \"assessment\": \"caution\",\n                  \"verdict\": \"增加等待\"\n                }\n              ],\n              \"id\": \"row-bb530b3792c8\"\n            },\n            {\n              \"label\": \"写回Redis\",\n              \"cells\": [\n                {\n                  \"text\": \"跳过\",\n                  \"assessment\": \"good\",\n                  \"verdict\": \"省去写回\"\n                },\n                {\n                  \"text\": \"同步SET\",\n                  \"assessment\": \"caution\",\n                  \"verdict\": \"增加等待\"\n                }\n              ],\n              \"id\": \"row-cbc9f8528502\"\n            },\n            {\n              \"label\": \"响应路径\",\n              \"cells\": [\n                {\n                  \"text\": \"一段读取\",\n                  \"assessment\": \"good\",\n                  \"verdict\": \"路径短\"\n                },\n                {\n                  \"text\": \"三段顺序等待\",\n                  \"assessment\": \"caution\",\n                  \"verdict\": \"路径长\"\n                }\n              ],\n              \"id\": \"row-d108c6645625\"\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"id\": \"checks\",\n      \"title\": \"想缩短等待，先查什么？\",\n      \"blocks\": [\n        {\n          \"type\": \"list\",\n          \"ordered\": false,\n          \"items\": [\n            \"记录`cache=hit`或`cache=miss`，区分请求路径。\",\n            \"分别观察GET、SQL和SET耗时，先处理最慢的一段。\",\n            \"检查SQL索引与执行计划；改为异步写回前，设计写入失败的恢复流程。\"\n          ],\n          \"id\": \"list-7e8599e477aa\"\n        }\n      ]\n    }\n  ],\n  \"sources\": [\n    {\n      \"id\": \"get-doc\",\n      \"title\": \"Redis GET：不存在的键返回空值\",\n      \"url\": \"https://redis.io/docs/latest/commands/get/\"\n    },\n    {\n      \"id\": \"set-doc\",\n      \"title\": \"Redis SET：设置键值\",\n      \"url\": \"https://redis.io/docs/latest/commands/set/\"\n    }\n  ]\n}\n",
