<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Archify.Net.Cli</RootNamespace>
    <AssemblyName>Archify.Net.Cli</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>archify</ToolCommandName>
    <!-- [LibraryImport] stubs (Paths/NativeFs.cs) are generated unsafe code -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Microsoft.Playwright ships .ps1 helpers (playwright.ps1, reinstall_msedge_*) that pack flags as NU5111; the tool never runs them (install-browser is in-process) -->
    <NoWarn>$(NoWarn);NU5111</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Archify.Net.Core\Archify.Net.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Q9: the upstream viewer-gate page scripts, verbatim; logical names "viewer-gate/settle.js", "viewer-gate/metrics.js" -->
    <EmbeddedResource Include="..\..\upstream\viewer-gate\*.js" LogicalName="viewer-gate/%(Filename)%(Extension)" />
    <!-- PORT-009: the two page functions of explainer/browser-check.mjs, verbatim; "explainer-gate/measure-native-previews.js", ... -->
    <EmbeddedResource Include="..\..\upstream\explainer-gate\*.js" LogicalName="explainer-gate/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Archify.Net.Cli.Tests" />
  </ItemGroup>
</Project>
